# OS-generated files
.DS_Store
Thumbs.db

# Python cache & build artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.so
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Tool configurations
.idea/
.vscode/
.claude/
.envrc
.env
.env.*
!.env.example
.mcp.json
config/daily-trading-routine.local.toml

# Logs & temp
logs/
*.log
*.tmp

# Jupyter
.ipynb_checkpoints/

# Generated reports
reports/
reviews/

# Stray screener reports if a script is run with --output-dir . (default is reports/)
canslim_screener_*.json
canslim_screener_*.md

# Per-symbol runtime state (e.g. parabolic-short SSR carryover files).
# Kept out of commits so production state never leaks into the repo.
state/

# Local work-in-progress staging (patch bundles, nested skill drafts, ad-hoc
# fetch scripts). Never place these under skills/ — an untracked path there
# blocks the automated skill loops, whose git safety check aborts on any
# untracked file. See docs/dev/maintenance-runbook.md.
.staging/
scripts/weekly_portfolio_review_fetch.py

# CI artifacts
htmlcov/
.coverage
# .secrets.baseline is tracked — needed by detect-secrets pre-commit hook

# Private TW market-data provider (galaxyark port) and its design spec.
# The upstream Rust crate is marked PRIVATE — DO NOT DISTRIBUTE, and this
# repo is a PUBLIC fork of tradermonty/claude-trading-skills, so neither the
# client nor any document carrying its endpoint map may be committed.
# NOTE: scripts/package_skills.py walks the filesystem and does NOT consult
# .gitignore — "_private" must also stay in its EXCLUDED_DIR_NAMES or the
# client gets zipped into the committed .skill archive.
skills/*/scripts/providers/_private/
docs/superpowers/specs/*-galaxyark-*.md
docs/superpowers/plans/*-galaxyark-*.md

# superpowers sdd working directory: holds full plan/task-brief artifacts for
# in-flight work, including the galaxyark port (hostnames, table IDs, source
# in plain text). Previously protected only by .superpowers/sdd/.gitignore
# ("*"), an untracked file that ignores itself — if that file were ever
# lost, the private material would become stageable. Ignore the whole
# directory here as a second, committed line of defense.
.superpowers/
